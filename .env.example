# Copy to .env. Optional: without a key SIGAP works fully, with the online check hidden.
# Read by the server only. Never prefix it with VITE_, which would put it in the browser bundle.

# https://developers.google.com/safe-browsing/reference
# Non-commercial use only.
SAFE_BROWSING_API=your-key-here

# Optional.
# SAFE_BROWSING_LIMIT_PER_HOUR=300
